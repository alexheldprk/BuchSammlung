

<!DOCTYPE html>

<html>
<body>
    <div id="popupFormular" class="popup">
        <div class="popup-inhalt">
            <span class="schliessen">&times;</span>
            <h3>Eintrag bearbeiten</h3>


            <div id="buchform">
                <form class="eingabe-formular">

                    <div class="form-row">
                        <label for="editTitel">Titel:</label>
                        <input type="text" id="titel" name="titel" required />
                    </div>

                    <div class="form-row">
                        <label for="editAutor">Autor:</label>
                        <input type="text" id="autor" name="autor" required />
                    </div>

                    <div class="form-row">
                        <label for="editIsbn">ISBN-Nummer:</label>
                        <input type="text" id="isbn" name="isbn" required />
                    </div>

                    <div class="form-row">
                        <label for="editJahr">Erscheinungsjahr:</label>
                        <input type="number" id="jahr" name="jahr" value="0" min="0" required />
                    </div>


                    <button id="saveEdit" class="btn btn-primary">Bestätigen</button>
                    <button id="cancelEdit" class="btn btn-secondary">Abbrechen</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>