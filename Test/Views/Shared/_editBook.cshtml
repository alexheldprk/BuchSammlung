    <div id="editPopup" class="popup">
        <div class="popup-inhalt">
            <span class="editclose">&times;</span>
            <h3>Eintrag bearbeiten</h3>


            <div id="buchform">
                <form class="editformular">
                    <div class="form-row">
                        <label for="editTitel">Titel:</label>
                        <input type="text" id="editTitel" required/>
                    </div>
                    <div class="form-row">
                        <label for="editAutor">Autor:</label>
                        <input type="text" id="editAutor" required/>
                    </div>
                    <div class="form-row">
                        <label for="editIsbn">ISBN-Nummer:</label>
                        <input type="text" id="editIsbn" required/>
                    </div>
                    <div class="form-row">
                        <label for="editJahr">Erscheinungsjahr:</label>
                        <input type="number" id="editJahr" min="0" required/>
                    </div>


                        <button id="saveEdit" class="btn btn-primary">Bestätigen</button>
                        <button id="cancelEdit" class="btn btn-secondary">Abbrechen</button>
                </form>
            </div>
        </div>
    </div>