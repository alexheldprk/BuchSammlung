@{
    ViewBag.Title = "Home Page";
}

<div>
    <h1>Büchersammlung</h1>
    <p>Das ist eine Website um seine <br />Büchersammlung digital zu dokumentieren</p>
</div>

<div class="searchbarContainer">
    <form>
        <input type="search" class="searchbar" placeholder="Live-Suche" />
    </form>
</div>

<div class="createButtonContainer">
    <button class="createButton">Neues Buch Hinzufügen</button>
</div>

<div class="tabelleContainer">
    <table id="bookTable">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Autor</th>
                <th>ISBN</th>
                <th>Jahr</th>
                <th>Aktionen</th>
            </tr>
        </thead>
        <tbody>

            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@Model[i].Id</td>
                    <td>@Model[i].Titel</td>
                    <td>@Model[i].Autor</td>
                    <td>@Model[i].ISBN</td>
                    <td>@Model[i].Jahr</td>
                </tr>
            }

